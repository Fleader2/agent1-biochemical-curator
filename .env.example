# Agent 1 environment configuration template.
#
# Copy to .env and fill in local values. Never commit a populated .env.
# Variable names only: no credentials belong in this file.

# --- Application ---------------------------------------------------------
APP_ENV=
LOG_LEVEL=
LOG_FORMAT=

# --- Database ------------------------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
# Separate database used by the test suite. Must differ from DATABASE_URL.
TEST_DATABASE_URL=
DATABASE_ECHO=

# --- Prompts and language model -----------------------------------------
# Not used yet; LLM integration is implemented in a later phase.
PROMPT_VERSION=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_TEMPERATURE=

# --- NCBI / PubMed -------------------------------------------------------
NCBI_EMAIL=
NCBI_TOOL_NAME=
NCBI_API_KEY=

# --- BRENDA --------------------------------------------------------------
BRENDA_USERNAME=
BRENDA_PASSWORD=

# --- KEGG ----------------------------------------------------------------
KEGG_BASE_URL=
